import { Button } from "std-widgets.slint";

export struct LogFilterCompletion {
    prefix: string,
    description: string,
    query: string,
    cursor: int,
}

export component LogSearch inherits Rectangle {
    in property <string> query;
    callback edited(string);
    pure callback complete(string, int) -> [LogFilterCompletion];
    private property <[LogFilterCompletion]> choices: root.complete(input.text, input.cursor-position-byte-offset);
    private property <int> selected: 0;
    private property <bool> dismissed: false;
    private property <bool> showing: input.has-focus && !root.dismissed
        && input.preedit-text == "" && input.cursor-position-byte-offset == input.anchor-position-byte-offset
        && root.choices.length > 0;

    height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 6px;
    background: #191b26;
    border-width: 1px;
    border-color: input.has-focus ? #4f80ff : #33384c;
    forward-focus: input;
    changed choices => { root.selected = 0; }

    function apply-completion(index: int) {
        if index >= 0 && index < root.choices.length {
            let choice = root.choices[index];
            input.text = choice.query;
            input.set-selection-offsets(choice.cursor, choice.cursor);
            root.dismissed = true;
            root.edited(input.text);
            input.focus();
        }
    }

    clear-button := Button {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 56px;
        height: parent.height - 8px;
        text: "清空";
        accessible-label: "清空日志过滤条件";
        enabled: input.text != "";
        clicked => {
            input.text = "";
            input.set-selection-offsets(0, 0);
            input.scroll-x = 0px;
            input.focus();
            root.dismissed = true;
            root.edited("");
        }
    }

    clip-area := Rectangle {
        x: 10px;
        width: max(0px, clear-button.x - self.x - 8px);
        height: parent.height;
        clip: true;

        Text {
            x: 0px;
            width: parent.width;
            height: parent.height;
            text: input.text == "" && input.preedit-text == "" ? "筛选日志，例如 package:com.example -message:timeout" : "";
            color: #747e99;
            font-size: 13px;
            horizontal-alignment: left;
            vertical-alignment: center;
            accessible-role: none;
        }

        ContextMenuArea {
            Menu {
                MenuItem { title: "撤销"; activated => { input.undo(); } }
                MenuItem { title: "重做"; activated => { input.redo(); } }
                MenuSeparator { }
                MenuItem { title: "剪切"; activated => { input.cut(); } }
                MenuItem { title: "复制"; activated => { input.copy(); } }
                MenuItem { title: "粘贴"; activated => { input.paste(); } }
                MenuItem { title: "全选"; activated => { input.select-all(); } }
            }

            input := TextInput {
                private property <length> scroll-x: 0px;
                x: min(0px, max(clip-area.width - self.width - self.text-cursor-width, self.scroll-x));
                width: max(clip-area.width - self.text-cursor-width, self.preferred-width);
                height: parent.height;
                text: root.query;
                color: #f8f8f2;
                font-size: 13px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #3a5285;
                selection-foreground-color: #ffffff;
                accessible-label: "筛选日志";
                accessible-placeholder-text: "package:包名 关键字，输入 - 可选择排除条件";

                cursor-position-changed(position) => {
                    if position.x + self.scroll-x < 0px {
                        self.scroll-x = -position.x;
                    } else if position.x + self.scroll-x > clip-area.width - self.text-cursor-width {
                        self.scroll-x = clip-area.width - position.x - self.text-cursor-width;
                    }
                }
                changed has-focus => { root.dismissed = !self.has-focus; }
                edited => {
                    root.dismissed = false;
                    root.edited(self.text);
                }
                key-pressed(event) => {
                    if self.preedit-text != "" { return reject; }
                    if event.text == Key.DownArrow && root.choices.length > 0 {
                        root.selected = root.showing ? mod(root.selected + 1, root.choices.length) : 0;
                        root.dismissed = false;
                        return accept;
                    }
                    if event.text == Key.UpArrow && root.showing {
                        root.selected = mod(root.selected + root.choices.length - 1, root.choices.length);
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == Key.Tab) && root.showing {
                        root.apply-completion(root.selected);
                        return accept;
                    }
                    if event.text == Key.Escape && root.showing {
                        root.dismissed = true;
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }

    if root.showing: Rectangle {
        x: 0px;
        y: root.height + 4px;
        width: min(root.width, 460px);
        height: 8px + root.choices.length * 32px + 26px;
        border-radius: 6px;
        border-width: 1px;
        border-color: #414963;
        background: #242838;
        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            for choice[index] in root.choices: Rectangle {
                height: 32px;
                border-radius: 4px;
                background: root.selected == index || touch.has-hover ? #3a4260 : transparent;
                accessible-role: button;
                accessible-label: choice.prefix + " " + choice.description;
                accessible-action-default => { root.apply-completion(index); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 14px;
                    Text {
                        width: 100px;
                        text: choice.prefix;
                        font-family: "monospace";
                        font-size: 13px;
                        color: #bd93f9;
                        vertical-alignment: center;
                    }
                    Text {
                        text: choice.description;
                        font-size: 12px;
                        color: #b4bdd4;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.apply-completion(index); }
                }
            }
            Text {
                height: 26px;
                text: "↑ ↓ 选择    Enter / Tab 补全    Esc 收起";
                color: #818ba5;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
