import { Button, ListView, LineEdit } from "std-widgets.slint";
import { App } from "app_state.slint";
import { CopyText } from "widgets.slint";

export component AppsTab inherits VerticalLayout {
    spacing: 12px;

    HorizontalLayout {
        spacing: 10px;

        Button {
            text: (App.app_filter_tab == 0) ? "🌐 全部应用 (选中)" : "全部应用";
            clicked => { App.app_filter_tab = 0; App.filter_apps(0); }
        }
        Button {
            text: (App.app_filter_tab == 1) ? "⚙️ 系统应用 (选中)" : "系统应用";
            clicked => { App.app_filter_tab = 1; App.filter_apps(1); }
        }
        Button {
            text: (App.app_filter_tab == 2) ? "⭐ 第三方应用 (选中)" : "第三方应用";
            clicked => { App.app_filter_tab = 2; App.filter_apps(2); }
        }

        Button {
            text: "🔄 刷新";
            clicked => { App.refresh_apps(); }
        }

        LineEdit {
            min-width: 100px;
            preferred-width: 280px;
            horizontal-stretch: 1;
            placeholder-text: "搜索应用名或包名…";
            text: App.app_search_query;
            edited => { App.search_apps(self.text); }
        }

        Text {
            text: App.app_status_text;
            min-width: 0px;
            preferred-width: 160px;
            horizontal-stretch: 0;
            font-size: 12px;
            color: #8b92ab;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Rectangle {
        background: #1c1e2b;
        border-radius: 8px;
        border-width: 1px;
        border-color: #2b2e40;

        VerticalLayout {
            Rectangle {
                height: 32px;
                background: #232636;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 26px;
                    spacing: 12px;
                    Rectangle { width: 32px; }
                    Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 27; text: "应用名"; font-size: 12px; font-weight: 600; color: #8e95ae; vertical-alignment: center; }
                    Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 43; text: "包名"; font-size: 12px; font-weight: 600; color: #8e95ae; vertical-alignment: center; }
                    Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 30; text: "版本 name (code)"; font-size: 12px; font-weight: 600; color: #8e95ae; vertical-alignment: center; }
                }
            }

            ListView {
                for app in App.app_items: Rectangle {
                    height: 52px;
                    background: touch_app.has-hover ? #252839 : transparent;

                    touch_app := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.launch_app(app.package_name); }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Rectangle {
                            width: 32px;
                            if app.has_icon: Image {
                                width: 32px;
                                height: 32px;
                                y: (parent.height - self.height) / 2;
                                source: app.icon;
                                image-fit: contain;
                            }
                            if !app.has_icon: Text {
                                text: app.is_system ? "⚙️" : "📦";
                                font-size: 22px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        Text {
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 27;
                            text: app.app_name;
                            font-size: 13px;
                            font-weight: 600;
                            color: #ffffff;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        CopyText {
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 43;
                            text: app.package_name;
                            font-size: 12px;
                            idle_color: #a0a5b8;
                            copy => { App.copy_clipboard(app.package_name); }
                        }

                        CopyText {
                            text: app.version_name + " (" + app.version_code + ")";
                            idle_color: #8b92ab;
                            font-size: 12px;
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 30;
                            copy => { App.copy_clipboard(app.version_name); }
                        }
                    }

                    // 右键弹出操作菜单；对左键穿透，不影响点击复制
                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "▶️ 启动";
                                activated => { App.launch_app(app.package_name); }
                            }
                            MenuItem {
                                title: "⏹️ 停止";
                                activated => { App.stop_app(app.package_name); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "💾 提取 APK";
                                activated => { App.extract_apk(app.apk_path, app.package_name); }
                            }
                            MenuItem {
                                title: "🧹 清理数据";
                                activated => { App.clear_app(app.package_name); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: app.is_system ? "🗑️ 卸载（当前用户）" : "🗑️ 卸载";
                                enabled: !App.is_busy;
                                activated => { App.uninstall_app(app.package_name); }
                            }
                        }
                    }
                }
            }
        }

        if App.app_search_query != "" && App.app_items.length == 0: Text {
            y: 32px;
            width: parent.width;
            height: parent.height - 32px;
            text: "没有匹配的应用，试试其他应用名或包名";
            font-size: 13px;
            color: #8b92ab;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
